{
    "name": "zorin/noter",
    "description": "CLI utility for creating and managing notes.",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "localzet/console": "^1.1",
        "localzet/http": "^2.0",
        "vlucas/phpdotenv": "^5.6",
        "localzet/zconf": "^1.0"
    },
    "license": "AGPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Zorin\\Noter\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Ivan Zorin",
            "email": "ivan@zorin.space"
        }
    ],
    "scripts": {
        "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
        "build": "php -d phar.readonly=0 build.php",
        "test": "bash tests/smoke.sh && php tests/integration.php"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
